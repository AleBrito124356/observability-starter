# Copy to .env and adjust. Every value has a working default; nothing here is
# required to run locally. There are no secrets in this project.

# --- Service identity (becomes OpenTelemetry Resource attributes) ---
SERVICE_NAME=observability-starter
SERVICE_VERSION=0.1.0
ENVIRONMENT=local

# --- Tracing / OTLP export ---
# Which span exporters to run: otlp, console, none, or a comma-separated list
# such as "otlp,console". "none" builds spans locally without exporting them.
# Any other value stops the service at startup with a clear error.
OTEL_TRACES_EXPORTER=otlp
# OTLP wire protocol: grpc (collector port 4317) or http/protobuf (port 4318).
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Collector base URL. Leave it unset to get the protocol's default
# (http://localhost:4317 for grpc, http://localhost:4318 for http/protobuf).
# For http/protobuf the per-signal path (/v1/traces) is appended for you.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# gRPC only: talk to the collector without TLS.
OTEL_EXPORTER_OTLP_INSECURE=true
# Head-based sampling ratio in [0, 1]: 1.0 keeps every trace, 0.1 keeps ~10%.
TRACE_SAMPLE_RATIO=1.0

# --- Logging ---
# DEBUG, INFO, WARNING (or WARN), ERROR, CRITICAL.
LOG_LEVEL=INFO
LOG_JSON=true

# --- Demo behaviour knobs ---
# URL that /api/external calls to exercise httpx instrumentation. The self-call
# default keeps everything offline; point it anywhere to see cross-service spans.
UPSTREAM_URL=http://localhost:8000/health
# Simulated dependency latency window, in milliseconds (min <= max).
SLOW_MIN_MS=20
SLOW_MAX_MS=400
# Fraction of order reads that fail, in [0, 1], so error traces and metrics show up.
FAILURE_RATE=0.1
