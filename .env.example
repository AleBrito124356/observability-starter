# Copy to .env and adjust. Every value has a working default; nothing here is
# required to run locally. There are no secrets in this project.

# --- Service identity (becomes OpenTelemetry Resource attributes) ---
SERVICE_NAME=observability-starter
SERVICE_VERSION=0.1.0
ENVIRONMENT=local

# --- Tracing / OTLP export ---
# Where to ship spans. In the docker-compose stack this is the collector.
# Running the app on the host against the compose stack? Use http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Set to "none" to build spans locally without exporting them anywhere.
OTEL_TRACES_EXPORTER=otlp
# Head-based sampling ratio: 1.0 keeps every trace, 0.1 keeps ~10%.
TRACE_SAMPLE_RATIO=1.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Demo behaviour knobs ---
# URL that /api/external calls to exercise httpx instrumentation. The self-call
# default keeps everything offline; point it anywhere to see cross-service spans.
UPSTREAM_URL=http://localhost:8000/health
# Simulated dependency latency window, in milliseconds.
SLOW_MIN_MS=20
SLOW_MAX_MS=400
# Fraction of order reads that fail, so error traces and metrics show up.
FAILURE_RATE=0.1
